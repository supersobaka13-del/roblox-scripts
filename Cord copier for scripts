        Size=UDim2.new(0,8,0,8),
        Position=UDim2.new(0,12,0.5,-4),
        BackgroundColor3=PROTECT[key] and C.green or C.red,
        ZIndex=5, Parent=card
    }
    corner(4,dot)

    mklabel{
        Text=txt,
        Size=UDim2.new(1,-70,0,20),
        Position=UDim2.new(0,28,0,10),
        TextColor3=C.txtMain,
        Font=Enum.Font.GothamBold,
        TextSize=12,
        TextXAlignment=Enum.TextXAlignment.Left,
        ZIndex=5, Parent=card
    }
    mklabel{
        Text=desc,
        Size=UDim2.new(1,-70,0,16),
        Position=UDim2.new(0,28,0,30),
        TextColor3=C.txtMute,
        Font=Enum.Font.Gotham,
        TextSize=9,
        TextXAlignment=Enum.TextXAlignment.Left,
        ZIndex=5, Parent=card
    }

    -- pill toggle
    local track=mkframe{
        Size=UDim2.new(0,42,0,22),
        Position=UDim2.new(1,-54,0.5,-11),
        BackgroundColor3=PROTECT[key] and col or C.panel,
        ZIndex=5, Parent=card
    }
    corner(11,track)
    local knob=mkframe{
        Size=UDim2.new(0,16,0,16),
        Position=PROTECT[key]
            and UDim2.new(1,-19,0.5,-8)
            or  UDim2.new(0,3,0.5,-8),
        BackgroundColor3=C.white,
        ZIndex=6, Parent=track
    }
    corner(8,knob)

    local btn=mkbtn{
        Size=UDim2.new(1,0,1,0),
        BackgroundTransparency=1,
        Text="",
        ZIndex=7, Parent=card
    }

    btn.MouseButton1Click:Connect(function()
        PROTECT[key]=not PROTECT[key]
        local on=PROTECT[key]
        TweenService:Create(dot,TweenInfo.new(0.15),{
            BackgroundColor3=on and C.green or C.red
        }):Play()
        TweenService:Create(track,TweenInfo.new(0.18),{
            BackgroundColor3=on and col or C.panel
        }):Play()
        TweenService:Create(knob,TweenInfo.new(0.18),{
            Position=on
                and UDim2.new(1,-19,0.5,-8)
                or  UDim2.new(0,3,0.5,-8)
        }):Play()
        applyProtect()
    end)

    card.MouseEnter:Connect(function()
        TweenService:Create(card,TweenInfo.new(0.12),{BackgroundColor3=C.cardHov}):Play()
    end)
    card.MouseLeave:Connect(function()
        TweenService:Create(card,TweenInfo.new(0.12),{BackgroundColor3=C.card}):Play()
    end)

    return card
end

