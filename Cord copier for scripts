-- ============================================================
-- HELPERS
-- ============================================================

local function corner(r,p)
    local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0,r) c.Parent=p return c
end
local function stroke(col,th,tr,p)
    local s=Instance.new("UIStroke") s.Color=col s.Thickness=th s.Transparency=tr s.Parent=p return s
end
local function gradSeq(seq,rot,p)
    local g=Instance.new("UIGradient") g.Color=seq g.Rotation=rot g.Parent=p return g
end
local function grad2(c0,c1,rot,p)
    return gradSeq(ColorSequence.new(c0,c1),rot,p)
end
local function mkframe(props)
    local f=Instance.new("Frame") f.BorderSizePixel=0
    for k,v in pairs(props) do if k~="Parent" then f[k]=v end end
    f.Parent=props.Parent return f
end
local function mklabel(props)
    local l=Instance.new("TextLabel") l.BackgroundTransparency=1 l.BorderSizePixel=0
    for k,v in pairs(props) do if k~="Parent" then l[k]=v end end
    l.Parent=props.Parent return l
end
local function mkbtn(props)
    local b=Instance.new("TextButton") b.BorderSizePixel=0
    for k,v in pairs(props) do if k~="Parent" then b[k]=v end end
    b.Parent=props.Parent return b
end

