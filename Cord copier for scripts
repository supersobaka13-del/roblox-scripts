        ZIndex=6,Parent=pill
    }
    local feedLabel=mklabel{
        Text="",
        Size=UDim2.new(0,80,1,0),
        Position=UDim2.new(1,-88,0,0),
        TextColor3=C.green,
        Font=Enum.Font.GothamBold,
        TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Right,
        ZIndex=6,Parent=pill
    }

    pill.MouseEnter:Connect(function()
        TweenService:Create(pill,TweenInfo.new(0.15),{BackgroundTransparency=0.15}):Play()
    end)
    pill.MouseLeave:Connect(function()
        TweenService:Create(pill,TweenInfo.new(0.15),{BackgroundTransparency=0}):Play()
    end)
    pill.MouseButton1Click:Connect(function()
        TweenService:Create(pill,TweenInfo.new(0.07),{Size=UDim2.new(1,-8,0,34)}):Play()
        task.delay(0.07,function()
            TweenService:Create(pill,TweenInfo.new(0.18,Enum.EasingStyle.Back),
                {Size=UDim2.new(1,0,0,38)}):Play()
        end)
