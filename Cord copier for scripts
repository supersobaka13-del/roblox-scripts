local function switchTab(name)
    currentTab = name
    for _,t in ipairs(tabsData) do
        tabPages[t.name].Visible = (t.name == name)
        local btn = tabBtns[t.name]
        if btn then
            local active = (t.name == name)
            TweenService:Create(btn,TweenInfo.new(0.15),{
                BackgroundTransparency = active and 0 or 1,
                BackgroundColor3 = active and C.acc1 or C.void,
                TextColor3 = active and C.white or C.txtMute,
            }):Play()
        end
    end
end

