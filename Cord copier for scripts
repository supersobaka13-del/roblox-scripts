-- ============================================================
-- PROTECT CONFIG
-- ============================================================

local PROTECT = {
    AntiKnockback = false,
    AntiRagdoll   = false,
    AntiFall      = false,
    AntiGrab      = false,
}

local protectConns = {}

local function disconnectProtect()
    for _,c in ipairs(protectConns) do
        pcall(function() c:Disconnect() end)
    end
    protectConns = {}
end

local function getChar()
    return lp.Character
end
local function getHum()
    local ch = getChar()
    return ch and ch:FindFirstChildOfClass("Humanoid")
end
local function getHRP()
    local ch = getChar()
    return ch and ch:FindFirstChild("HumanoidRootPart")
end

local antiFallConn = nil
local savedPos = nil

local function applyProtect()
    disconnectProtect()

    local ch = getChar()
    if not ch then return end
    local hum = getHum()
    local hrp = getHRP()

    -- ANTI KNOCKBACK
    -- уничтожаем BodyVelocity / LinearVelocity / BodyForce как только появляются
    if PROTECT.AntiKnockback then
        local conn = ch.DescendantAdded:Connect(function(obj)
            if obj:IsA("BodyVelocity")
            or obj:IsA("BodyAngularVelocity")
            or obj:IsA("VectorForce")
            or obj:IsA("LinearVelocity")
            or obj:IsA("BodyForce")
            or obj:IsA("BodyGyro") then
                task.defer(function()
                    pcall(function() obj:Destroy() end)
                end)
            end
        end)
        table.insert(protectConns, conn)

        -- каждый кадр зануляем AssemblyLinearVelocity
        local kbLoop = RunService.Heartbeat:Connect(function()
            if not PROTECT.AntiKnockback then return end
            local r = getHRP()
            if r then
                r.AssemblyLinearVelocity = Vector3.new(0, r.AssemblyLinearVelocity.Y, 0)
            end
        end)
        table.insert(protectConns, kbLoop)
    end

    -- ANTI RAGDOLL
    -- восстанавливаем Motor6D если их убивают + ставим PlatformStand = false
    if PROTECT.AntiRagdoll and hum then
        local ragConn = RunService.Heartbeat:Connect(function()
            if not PROTECT.AntiRagdoll then return end
            local h = getHum()
            if h then
                if h:GetState() == Enum.HumanoidStateType.Ragdoll
                or h:GetState() == Enum.HumanoidStateType.FallingDown then
                    h:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
                h.PlatformStand = false
            end
            -- убиваем BallSocketConstraint / HingeConstraint добавленные как рагдолл
            local c2 = getChar()
            if c2 then
                for _, v in ipairs(c2:GetDescendants()) do
                    if v:IsA("BallSocketConstraint") or v:IsA("HingeConstraint") then
                        local n = v.Name:lower()
                        if n:find("ragdoll") or n:find("collapse") then
                            pcall(function() v:Destroy() end)
                        end
                    end
                end
            end
        end)
        table.insert(protectConns, ragConn)
    end

    -- ANTI FALL (anti fly-off / anti fling)
    -- сохраняет позицию на земле, при фулл-фале возвращает
    if PROTECT.AntiFall then
        local lastSafePos = nil
        local lastSafeTime = 0

        local fallLoop = RunService.Heartbeat:Connect(function()
            if not PROTECT.AntiFall then return end
            local r = getHRP()
            local h = getHum()
            if not r or not h then return end

            local speed = r.AssemblyLinearVelocity
            local t = tick()

            -- сохраняем "безопасную" позицию когда на земле
            if h:GetState() == Enum.HumanoidStateType.Running
            or h:GetState() == Enum.HumanoidStateType.Idle then
                if t - lastSafeTime > 0.5 then
                    lastSafePos = r.Position
                    lastSafeTime = t
                end
            end

            -- если вертикальная скорость слишком большая (фусс / флинг) — ТП назад
            local vertSpeed = math.abs(speed.Y)
            local horizSpeed = Vector2.new(speed.X, speed.Z).Magnitude
            if (vertSpeed > 120 or horizSpeed > 200) and lastSafePos then
                r.CFrame = CFrame.new(lastSafePos + Vector3.new(0, 3, 0))
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end
        end)
        table.insert(protectConns, fallLoop)
    end

    -- ANTI GRAB
    -- убиваем Weld / WeldConstraint с подозрительными именами
    if PROTECT.AntiGrab then
        local grabConn = ch.DescendantAdded:Connect(function(obj)
            if obj:IsA("Weld") or obj:IsA("WeldConstraint") or obj:IsA("Motor6D") then
                local n = obj.Name:lower()
                if n:find("grab") or n:find("attach") or n:find("rope")
                or n:find("chain") or n:find("hold") or n:find("carry") then
                    task.defer(function()
                        pcall(function() obj:Destroy() end)
                    end)
                end
            end
        end)
        table.insert(protectConns, grabConn)
    end
end

-- переприменяем при респавне
lp.CharacterAdded:Connect(function()
    task.wait(1)
    applyProtect()
end)

