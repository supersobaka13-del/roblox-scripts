function _onyx_updateOpenButton()
    if _onyx_uiHidden then
        _onyx_openUIToggle.Text = "OPEN"
        _onyx_openUIToggle.TextColor3 = _onyx_currentTheme.ActiveText
        _onyx_openUIToggle.BackgroundColor3 = _onyx_currentTheme.AccentSoft
        _onyx_openUIToggleStroke.Color = _onyx_currentTheme.Accent
    else
        _onyx_openUIToggle.Text = "HIDE"
        _onyx_openUIToggle.TextColor3 = _onyx_currentTheme.ButtonText
        _onyx_openUIToggle.BackgroundColor3 = _onyx_currentTheme.ButtonBg
        _onyx_openUIToggleStroke.Color = _onyx_currentTheme.Border
    end
end

function _onyx_setMainVisible(visible)
    if _onyx_closing then
        return
    end

    if visible then
        _onyx_uiHidden = false
        _onyx_main.Visible = true
        _onyx_sidebar.Visible = true
        _onyx_content.Visible = true
        _onyx_minimized = false
        _onyx_main.Size = UDim2.fromOffset(720, 390)
        _onyx_minimize.Text = "−"
        if _onyx_themePicker then
            _onyx_themePicker.Visible = false
            if _onyx_uiColorsButton then
                _onyx_uiColorsButton.Text = "OPEN"
            end
        end
    else
        if _onyx_themePicker then
            _onyx_themePicker.Visible = false
            if _onyx_uiColorsButton then
                _onyx_uiColorsButton.Text = "OPEN"
            end
        end
        _onyx_uiHidden = true
        -- Keep the top/title bar visible while hiding only the main content.
        _onyx_main.Visible = true
        _onyx_sidebar.Visible = false
        _onyx_content.Visible = false
        _onyx_main.Size = UDim2.fromOffset(720, 32)
        _onyx_minimize.Text = "+"
    end

    _onyx_updateOpenButton()
end

