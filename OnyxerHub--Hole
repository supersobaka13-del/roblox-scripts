_onyx_inputConnection = _onyx_UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    if _onyx_waitingForOpenKey then
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            _onyx_openHotkey = input.KeyCode
            _onyx_waitingForOpenKey = false
            _onyx_openKeyButton.Text = _onyx_openHotkey.Name
            _onyx_openKeyStroke.Color = _onyx_currentTheme.Border
        end
        return
    end

    if _onyx_waitingForSpeedKey then
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            _onyx_speedKey = input.KeyCode
            _onyx_waitingForSpeedKey = false
            _onyx_updateSpeedKeyText()
            _onyx_speedKeyStroke.Color = Color3.fromRGB(55, 58, 80)
        end
        return
    end

    if input.KeyCode == _onyx_openHotkey and not gameProcessedEvent then
        _onyx_setMainVisible(_onyx_uiHidden)
        return
    end

    if input.KeyCode == spawnHotkey and not gameProcessedEvent then
        _onyx_flyToSpawn()
        return
    end

    if input.KeyCode == _onyx_speedKey and not gameProcessedEvent then
        _onyx_toggleSpeed()
    end
end)

