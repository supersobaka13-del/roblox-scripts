_onyx_antiAFKEnabled = false
_onyx_antiAFKConnection = nil

function _onyx_updateAntiAFKButton()
    if _onyx_antiAFKToggle then
        if _onyx_antiAFKEnabled then
            _onyx_antiAFKToggle.Text = "ON"
            _onyx_antiAFKToggle.TextColor3 = Color3.fromRGB(225, 240, 255)
            _onyx_antiAFKToggle.BackgroundColor3 = Color3.fromRGB(24, 35, 48)
            _onyx_antiAFKToggleStroke.Color = _onyx_currentTheme.Accent
        else
            _onyx_antiAFKToggle.Text = "OFF"
            _onyx_antiAFKToggle.TextColor3 = _onyx_currentTheme.ToggleText
            _onyx_antiAFKToggle.BackgroundColor3 = _onyx_currentTheme.ButtonBg
            _onyx_antiAFKToggleStroke.Color = _onyx_currentTheme.Border
        end
    end
end

function _onyx_stopAntiAFK()
    _onyx_antiAFKEnabled = false
    if _onyx_antiAFKConnection then
        _onyx_antiAFKConnection:Disconnect()
        _onyx_antiAFKConnection = nil
    end
    _onyx_updateAntiAFKButton()
end

function _onyx_startAntiAFK()
    if _onyx_antiAFKEnabled then
        return
    end

    _onyx_antiAFKEnabled = true
    _onyx_antiAFKConnection = _onyx_player.Idled:Connect(function()
        if not _onyx_antiAFKEnabled then
            return
        end
        pcall(function()
            _onyx_VirtualUser:CaptureController()
            _onyx_VirtualUser:ClickButton2(Vector2.new(0, 0))
        end)
    end)
    _onyx_updateAntiAFKButton()
end

function _onyx_toggleAntiAFK()
    if _onyx_antiAFKEnabled then
        _onyx_stopAntiAFK()
    else
        _onyx_startAntiAFK()
    end
end

