function _onyx_getItemPosition(instance)
    local part = _onyx_getItemAdornee(instance)
    if not part then
        return nil
    end
    return part.Position
end

function _onyx_restoreItemTPNoClip()
    for part, canCollide in pairs(itemTPNoClipParts) do
        if part and part.Parent and part:IsA("BasePart") then
            part.CanCollide = canCollide
        end
    end
    table.clear(itemTPNoClipParts)
end

function _onyx_enableItemTPNoClip(character)
    _onyx_restoreItemTPNoClip()
    if not character then
        return
    end

    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("BasePart") then
            itemTPNoClipParts[descendant] = descendant.CanCollide
            descendant.CanCollide = false
        end
    end
end

function _onyx_refreshItemTPNoClip()
    if not _onyx_itemTPTeleporting or not _onyx_player.Character then
        return
    end

    for _, descendant in ipairs(_onyx_player.Character:GetDescendants()) do
        if descendant:IsA("BasePart") then
            if itemTPNoClipParts[descendant] == nil then
                itemTPNoClipParts[descendant] = descendant.CanCollide
            end
            descendant.CanCollide = false
        end
    end
end

function _onyx_stopItemTP()
    _onyx_itemTPTeleporting = false

    if _onyx_itemTPConnection then
        _onyx_itemTPConnection:Disconnect()
        _onyx_itemTPConnection = nil
    end

    if itemTPHumanoid and itemTPSavedWalkSpeed ~= nil and itemTPHumanoid.Parent then
        itemTPHumanoid.WalkSpeed = itemTPSavedWalkSpeed
    end

    if itemTPHumanoid then
        itemTPHumanoid.AutoRotate = true
    end

    _onyx_restoreItemTPNoClip()

    itemTPHumanoid = nil
    itemTPRoot = nil
    itemTPSavedWalkSpeed = nil
end

function _onyx_startItemTPFlight(targetCFrame, flightSpeed, secondTargetCFrame)
    _onyx_stopItemTP()

    if not targetCFrame then
        return
    end

    local character = _onyx_player.Character
    local root = character and _onyx_findRootPart(character)
    local humanoid = _onyx_getHumanoid()
    if not root or not humanoid then
        return
    end

    _onyx_itemTPTeleporting = true
    itemTPHumanoid = humanoid
    itemTPRoot = root
    itemTPSavedWalkSpeed = humanoid.WalkSpeed
    humanoid.AutoRotate = false

    -- NoClip exists only for the duration of the active TP flight.
    _onyx_enableItemTPNoClip(character)

    -- Keep the requested flight speed fixed for this trip.
    flightSpeed = math.max(1, tonumber(flightSpeed) or 200)

    _onyx_itemTPConnection = _onyx_RunService.Heartbeat:Connect(function(dt)
        if not _onyx_itemTPTeleporting or not root.Parent or not humanoid.Parent then
            _onyx_stopItemTP()
            return
        end

        _onyx_refreshItemTPNoClip()

        local targetPosition = targetCFrame.Position
        local delta = targetPosition - root.Position
        local distance = delta.Magnitude

        if distance <= 2.5 then
            root.CFrame = CFrame.new(targetPosition) * targetCFrame.Rotation
            root.AssemblyLinearVelocity = Vector3.zero

            -- Spawn TP can use a two-stage path: first 10 studs below the spawn,
            -- then rise back up to the real spawn position. Item TP remains single-stage.
            if secondTargetCFrame then
                targetCFrame = secondTargetCFrame
                secondTargetCFrame = nil
                return
            end

            _onyx_stopItemTP()
            return
        end

        local step = math.min(distance, flightSpeed * math.max(dt, 1 / 240))
        local nextPosition = root.Position + delta.Unit * step
        root.CFrame = CFrame.new(nextPosition) * root.CFrame.Rotation
        root.AssemblyLinearVelocity = Vector3.zero
    end)
end

function _onyx_flyToItem(itemName)
    local instance = _onyx_findItemInstance(itemName)
    if not instance then
        return
    end

    local part = _onyx_getItemAdornee(instance)
    if not part then
        return
    end

    -- Every item TP button uses a fixed 200 studs/s flight speed.
    _onyx_startItemTPFlight(CFrame.new(part.Position + Vector3.new(0, 2.5, 0)), 200)
end

function _onyx_flyToSpawn()
    if not _onyx_savedSpawnCFrame then
        return
    end

    -- Spawn TP uses the player's actual current WalkSpeed (the value used by the game).
    local humanoid = _onyx_getHumanoid()
    local serverWalkSpeed = humanoid and humanoid.WalkSpeed or 16

    -- Spawn TP: first fly to a point 10 studs below the real spawn,
    -- then fly upward onto the spawn point.
    local belowSpawnCFrame = _onyx_savedSpawnCFrame * CFrame.new(0, -10, 0)
    local finalSpawnCFrame = _onyx_savedSpawnCFrame * CFrame.new(0, 2, 0)

    _onyx_startItemTPFlight(belowSpawnCFrame, serverWalkSpeed, finalSpawnCFrame)
end

