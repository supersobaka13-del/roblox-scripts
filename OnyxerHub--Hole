-- =========================================
-- CLOSE
-- =========================================

_onyx_closing = false

function _onyx_animateMainClose()
    local closeTweens = {}
    local targetSize = UDim2.fromOffset(640, 350)
    local targetPosition = UDim2.new(0.5, -320, 0.5, -175)

    for _, object in ipairs(_onyx_main:GetDescendants()) do
        if object:IsA("TextLabel") or object:IsA("TextButton") then
            table.insert(closeTweens, _onyx_TweenService:Create(
                object,
                TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                { TextTransparency = 1 }
            ))
        elseif object:IsA("UIStroke") then
            table.insert(closeTweens, _onyx_TweenService:Create(
                object,
                TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                { Transparency = 1 }
            ))
        end
    end

    for _, tween in ipairs(closeTweens) do
        tween:Play()
    end

    local sizeTween = _onyx_TweenService:Create(
        _onyx_main,
        TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
        {
            Size = targetSize,
            Position = targetPosition,
            BackgroundTransparency = 1,
        }
    )
    sizeTween:Play()
    sizeTween.Completed:Wait()
end

function _onyx_closeGui()
    if _onyx_closing then
        return
    end

    _onyx_closing = true

    if _onyx_speedEnabled then
        _onyx_stopSpeed()
    end
    if _onyx_playerESPEnabled then
        _onyx_stopPlayerESP()
    end
    if _onyx_itemESPEnabled then
        _onyx_stopItemESP()
    end
    if _onyx_autoStrongEnabled then
        _onyx_stopAutoStrong()
    end
    if _onyx_antiAFKEnabled then
        _onyx_stopAntiAFK()
    end
    _onyx_stopItemTP()
    _onyx_itemTPPanel.Visible = false

    if _onyx_speedHeartbeat then
        _onyx_speedHeartbeat:Disconnect()
        _onyx_speedHeartbeat = nil
    end

    if _onyx_playerESPHeartbeat then
        _onyx_playerESPHeartbeat:Disconnect()
    end

    for _, connection in ipairs(_onyx_playerESPConnections) do
        connection:Disconnect()
    end
    table.clear(_onyx_playerESPConnections)

    if _onyx_inputConnection then
        _onyx_inputConnection:Disconnect()
        _onyx_inputConnection = nil
    end

    if _onyx_itemChildConnection then
        _onyx_itemChildConnection:Disconnect()
        _onyx_itemChildConnection = nil
    end

    if _onyx_itemDescendantConnection then
        _onyx_itemDescendantConnection:Disconnect()
        _onyx_itemDescendantConnection = nil
    end

    if _onyx_itemRefreshConnection then
        task.cancel(_onyx_itemRefreshConnection)
        _onyx_itemRefreshConnection = nil
    end

    if _onyx_main.Visible then
        _onyx_animateMainClose()
    end

    _onyx_gui:Destroy()
end

