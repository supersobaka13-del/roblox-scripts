function _onyx_makePumpkin(parent, position, size)
    local pumpkin = Instance.new("Frame")
    pumpkin.Size = UDim2.fromOffset(size, math.floor(size * 0.82))
    pumpkin.Position = position
    pumpkin.BackgroundColor3 = Color3.fromRGB(244, 113, 28)
    pumpkin.BorderSizePixel = 0
    pumpkin.ZIndex = 81
    pumpkin.Parent = parent
    pumpkin:SetAttribute("OnyxThemeIgnore", true)

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, math.floor(size * 0.38))
    corner.Parent = pumpkin

    local stem = Instance.new("Frame")
    stem.Size = UDim2.fromOffset(math.max(4, math.floor(size * 0.15)), math.max(5, math.floor(size * 0.20)))
    stem.Position = UDim2.new(0.5, -math.floor(size * 0.075), 0, -math.floor(size * 0.10))
    stem.BackgroundColor3 = Color3.fromRGB(99, 67, 32)
    stem.BorderSizePixel = 0
    stem.ZIndex = 82
    stem.Parent = pumpkin
    stem:SetAttribute("OnyxThemeIgnore", true)

    local function eye(x)
        local e = Instance.new("Frame")
        e.Size = UDim2.fromOffset(math.max(3, math.floor(size * 0.12)), math.max(3, math.floor(size * 0.12)))
        e.Position = UDim2.new(x, -math.floor(size * 0.06), 0, math.floor(size * 0.32))
        e.BackgroundColor3 = Color3.fromRGB(28, 12, 10)
        e.BorderSizePixel = 0
        e.Rotation = x < 0.5 and -10 or 10
        e.ZIndex = 82
        e.Parent = pumpkin
        e:SetAttribute("OnyxThemeIgnore", true)
    end

    eye(0.31)
    eye(0.69)

    local mouth = Instance.new("Frame")
    mouth.Size = UDim2.fromOffset(math.max(6, math.floor(size * 0.38)), math.max(3, math.floor(size * 0.09)))
    mouth.Position = UDim2.new(0.5, -math.floor(size * 0.19), 0, math.floor(size * 0.58))
    mouth.BackgroundColor3 = Color3.fromRGB(28, 12, 10)
    mouth.BorderSizePixel = 0
    mouth.ZIndex = 82
    mouth.Parent = pumpkin
    mouth:SetAttribute("OnyxThemeIgnore", true)

    local tooth = Instance.new("Frame")
    tooth.Size = UDim2.fromOffset(math.max(2, math.floor(size * 0.07)), math.max(2, math.floor(size * 0.09)))
    tooth.Position = UDim2.new(0.5, -1, 0, math.floor(size * 0.58))
    tooth.BackgroundColor3 = Color3.fromRGB(255, 169, 55)
    tooth.BorderSizePixel = 0
    tooth.ZIndex = 83
    tooth.Parent = pumpkin
    tooth:SetAttribute("OnyxThemeIgnore", true)
end

function _onyx_makeWeb(parent, position, size)
    local web = Instance.new("Frame")
    web.Size = UDim2.fromOffset(size, size)
    web.Position = position
    web.BackgroundTransparency = 1
    web.BorderSizePixel = 0
    web.ZIndex = 80
    web.Parent = parent
    web:SetAttribute("OnyxThemeIgnore", true)

    local lines = {
        {Vector2.new(0.5,0), Vector2.new(0.5,1)},
        {Vector2.new(0,0.5), Vector2.new(1,0.5)},
        {Vector2.new(0.15,0.15), Vector2.new(0.85,0.85)},
        {Vector2.new(0.85,0.15), Vector2.new(0.15,0.85)},
    }
    for _, pair in ipairs(lines) do
        local a,b=pair[1],pair[2]
        local line=Instance.new("Frame")
        local dx=(b.X-a.X)*size
        local dy=(b.Y-a.Y)*size
        local len=math.sqrt(dx*dx+dy*dy)
        line.Size=UDim2.fromOffset(math.floor(len),2)
        line.Position=UDim2.fromOffset(math.floor(a.X*size), math.floor(a.Y*size))
        line.AnchorPoint=Vector2.new(0,0.5)
        line.Rotation=math.deg(math.atan2(dy,dx))
        line.BackgroundColor3=Color3.fromRGB(180,120,205)
        line.BackgroundTransparency=0.15
        line.BorderSizePixel=0
        line.ZIndex=81
        line.Parent=web
        line:SetAttribute("OnyxThemeIgnore", true)
    end

    for ring=1,3 do
        local ringFrame=Instance.new("Frame")
        ringFrame.Size=UDim2.fromScale(0.25+ring*0.18,0.25+ring*0.18)
        ringFrame.Position=UDim2.fromScale(0.375-ring*0.09,0.375-ring*0.09)
        ringFrame.BackgroundTransparency=1
        ringFrame.BorderColor3=Color3.fromRGB(180,120,205)
        ringFrame.BorderSizePixel=1
        ringFrame.ZIndex=81
        ringFrame.Parent=web
        ringFrame:SetAttribute("OnyxThemeIgnore", true)
    end
end

