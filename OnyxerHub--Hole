end)

-- Reset once on startup so Spawn/TP can learn the actual post-respawn base.
-- The CharacterAdded handler above will save the new spawn CFrame.
_onyx_spawnResetDone = false

function _onyx_resetPlayerForSpawnDetection()
    if _onyx_spawnResetDone then
        return
    end

    local character = _onyx_player.Character
    if not character then
        return
    end

    _onyx_savedSpawnCFrame = nil
    _onyx_spawnResetDone = true

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        -- Trigger a normal character death so Roblox respawns the player at the
        -- real server spawn. The CharacterAdded callback captures that position.
        humanoid.Health = 0
    else
        character:BreakJoints()
    end
end

