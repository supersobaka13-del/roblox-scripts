function _onyx_themeKey(c)
    return string.format("%d,%d,%d", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

function _onyx_tagThemeRoles()
    local backgroundMap = {
        ["8,9,16"] = "MainBg", ["11,12,21"] = "SurfaceBg", ["7,8,14"] = "ContentBg",
        ["14,15,24"] = "PanelRowBg", ["10,11,18"] = "ScrollBg", ["18,20,30"] = "ButtonBg",
        ["25,27,40"] = "ActiveBg", ["20,22,32"] = "BarBg", ["85,150,220"] = "AccentBg",
    }
    local textMap = {
        ["220,220,230"] = "PrimaryText", ["190,190,205"] = "SecondaryText", ["130,130,145"] = "MutedText",
        ["135,137,150"] = "SidebarText", ["225,225,235"] = "ActiveText", ["145,145,160"] = "ToggleText",
        ["205,205,218"] = "ButtonText", ["215,220,230"] = "ButtonText",
    }

    for _, object in ipairs(_onyx_gui:GetDescendants()) do
        if object:GetAttribute("OnyxThemeIgnore") then continue end
        if object:IsA("GuiObject") then
            local role = backgroundMap[_onyx_themeKey(object.BackgroundColor3)]
            if role then object:SetAttribute("OnyxThemeRole", role) end
        end
        if object:IsA("TextLabel") or object:IsA("TextButton") then
            local textRole = textMap[_onyx_themeKey(object.TextColor3)]
            if textRole then object:SetAttribute("OnyxTextRole", textRole) end
        end
    end
end

