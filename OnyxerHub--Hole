function _onyx_getSpawnedItems()
    return workspace:FindFirstChild("SpawnedItems")
end

function _onyx_normalizedName(value)
    return string.lower((value or ""):gsub("%s+", ""))
end

_onyx_findItemInstance = function(itemName)
    local _onyx_spawnedItems = _onyx_getSpawnedItems()
    if not _onyx_spawnedItems then
        return nil
    end

    local target = _onyx_normalizedName(itemName)

    for _, child in ipairs(_onyx_spawnedItems:GetChildren()) do
        if _onyx_normalizedName(child.Name) == target then
            return child
        end
    end

    for _, descendant in ipairs(_onyx_spawnedItems:GetDescendants()) do
        if _onyx_normalizedName(descendant.Name) == target then
            return descendant
        end
    end

    return nil
end

function _onyx_destroyItemESP(itemName)
    local entry = _onyx_itemEntries[itemName]
    if not entry then
        return
    end

    if entry.highlight then
        entry.highlight:Destroy()
    end
    if entry.billboard then
        entry.billboard:Destroy()
    end

    _onyx_itemEntries[itemName] = nil
end

_onyx_getItemAdornee = function(instance)
    if instance:IsA("BasePart") then
        return instance
    end

    if instance:IsA("Model") then
        if instance.PrimaryPart then
            return instance.PrimaryPart
        end
        return instance:FindFirstChildWhichIsA("BasePart", true)
    end

    return instance:FindFirstChildWhichIsA("BasePart", true)
end

function _onyx_createItemESP(itemName, instance)
    if not _onyx_itemESPEnabled or not _onyx_itemEnabled[itemName] or not instance then
        return
    end

    _onyx_destroyItemESP(itemName)

    local adorneePart = _onyx_getItemAdornee(instance)
    if not adorneePart then
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "PotassiumItemESP"
    local highlightAdornee = (instance:IsA("Model") or instance:IsA("BasePart")) and instance or adorneePart
    highlight.Adornee = highlightAdornee
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = Color3.fromRGB(255, 180, 70)
    highlight.OutlineColor = Color3.fromRGB(255, 228, 165)
    highlight.FillTransparency = 0.82
    highlight.OutlineTransparency = 0.05
    highlight.Parent = highlightAdornee

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "PotassiumItemESPInfo"
    billboard.Adornee = adorneePart
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.fromOffset(145, 28)
    billboard.StudsOffset = Vector3.new(0, 2.25, 0)
    billboard.MaxDistance = 5000
    billboard.Parent = _onyx_gui

    local background = Instance.new("Frame")
    background.Size = UDim2.fromScale(1, 1)
    background.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
    background.BackgroundTransparency = 0.2
    background.BorderSizePixel = 0
    background.Parent = billboard

    local backgroundCorner = Instance.new("UICorner")
    backgroundCorner.CornerRadius = UDim.new(0, 5)
    backgroundCorner.Parent = background

    local backgroundStroke = Instance.new("UIStroke")
    backgroundStroke.Color = Color3.fromRGB(255, 180, 70)
    backgroundStroke.Thickness = 1
    backgroundStroke.Transparency = 0.1
    backgroundStroke.Parent = background

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 1, 0)
    label.Position = UDim2.fromOffset(5, 0)
    label.BackgroundTransparency = 1
    label.Text = itemName
    label.TextColor3 = Color3.fromRGB(255, 239, 210)
    label.TextSize = 10
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.Parent = background

    _onyx_itemEntries[itemName] = {
        instance = instance,
        highlight = highlight,
        billboard = billboard,
    }
end

function _onyx_refreshItemESP(itemName)
    if not _onyx_itemESPEnabled or not _onyx_itemEnabled[itemName] then
        _onyx_destroyItemESP(itemName)
        return
    end

    local instance = _onyx_findItemInstance(itemName)
    local current = _onyx_itemEntries[itemName]

    if current and current.instance == instance and instance and instance.Parent then
        return
    end

    _onyx_destroyItemESP(itemName)

    if instance then
        _onyx_createItemESP(itemName, instance)
    end
end

function _onyx_refreshAllItemESP()
    if not _onyx_itemESPEnabled then
        for itemName in pairs(_onyx_itemEntries) do
            _onyx_destroyItemESP(itemName)
        end
        return
    end

    for _, itemName in ipairs(_onyx_itemNames) do
        _onyx_refreshItemESP(itemName)
    end
end

