        _onyx_itemChildConnection = nil
    end

    if _onyx_itemDescendantConnection then
        _onyx_itemDescendantConnection:Disconnect()
        _onyx_itemDescendantConnection = nil
    end

    _onyx_itemChildConnection = container.ChildAdded:Connect(function()
        if _onyx_itemESPEnabled then
            task.defer(_onyx_refreshAllItemESP)
        end
    end)
    _onyx_itemDescendantConnection = container.DescendantAdded:Connect(function()
        if _onyx_itemESPEnabled then
            task.defer(_onyx_refreshAllItemESP)
        end
    end)
end

