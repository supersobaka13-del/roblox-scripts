function _onyx_applyTheme(themeName)
    local theme = _onyx_themes[themeName]
    if not theme then return end

    _onyx_currentThemeName = themeName
    _onyx_currentTheme = theme

    _onyx_main.BackgroundColor3 = theme.MainBg
    _onyx_sidebar.BackgroundColor3 = theme.SidebarBg
    _onyx_content.BackgroundColor3 = theme.ContentBg
    _onyx_mainStroke.Color = theme.Border
    _onyx_sidebarStroke.Color = theme.Border
    _onyx_contentStroke.Color = theme.Border
    _onyx_headerSeparator.BackgroundColor3 = theme.HeaderSep

    for _, object in ipairs(_onyx_gui:GetDescendants()) do
        if object:GetAttribute("OnyxThemeIgnore") then
            continue
        end

        local role = object:GetAttribute("OnyxThemeRole")
        if role and object:IsA("GuiObject") then
            if role == "MainBg" then object.BackgroundColor3 = theme.MainBg
            elseif role == "SidebarBg" then object.BackgroundColor3 = theme.SidebarBg
            elseif role == "ContentBg" then object.BackgroundColor3 = theme.ContentBg
            elseif role == "SurfaceBg" then object.BackgroundColor3 = theme.SurfaceBg
            elseif role == "PanelRowBg" then object.BackgroundColor3 = theme.PanelRowBg
            elseif role == "ScrollBg" then object.BackgroundColor3 = theme.ScrollBg
            elseif role == "ButtonBg" then object.BackgroundColor3 = theme.ButtonBg
            elseif role == "ActiveBg" then object.BackgroundColor3 = theme.ActiveBg
            elseif role == "BarBg" then object.BackgroundColor3 = theme.BarBg
            elseif role == "AccentBg" then object.BackgroundColor3 = theme.Accent
            end
        end

        if object:IsA("TextLabel") or object:IsA("TextButton") then
            local textRole = object:GetAttribute("OnyxTextRole")
            if textRole == "PrimaryText" then object.TextColor3 = theme.PrimaryText
            elseif textRole == "SecondaryText" then object.TextColor3 = theme.SecondaryText
            elseif textRole == "MutedText" then object.TextColor3 = theme.MutedText
            elseif textRole == "SidebarText" then object.TextColor3 = theme.SidebarText
            elseif textRole == "ActiveText" then object.TextColor3 = theme.ActiveText
            elseif textRole == "ToggleText" then object.TextColor3 = theme.ToggleText
            elseif textRole == "ButtonText" then object.TextColor3 = theme.ButtonText
            end
        end

        if object:IsA("UIStroke") then
            local c = object.Color
            local isOrange = c.R > 0.9 and c.G > 0.45 and c.G < 0.85 and c.B < 0.35
            if not isOrange then object.Color = theme.Border end
        end
    end

    -- Re-assert the three core surfaces after role-based recoloring.
    _onyx_main.BackgroundColor3 = theme.MainBg
    _onyx_sidebar.BackgroundColor3 = theme.SidebarBg
    _onyx_content.BackgroundColor3 = theme.ContentBg

    for btnName, data in pairs(buttons) do
        if data and data.Button then
            if btnName == _onyx_pages.__activePage then
                data.Button.BackgroundColor3 = theme.AccentSoft
                data.Button.TextColor3 = theme.ActiveText
                data.Stroke.Color = theme.Accent
            else
                data.Button.BackgroundColor3 = theme.SidebarBg
                data.Button.TextColor3 = theme.SidebarText
                data.Stroke.Color = theme.Border
            end
        end
    end

    _onyx_uiColorsButton.BackgroundColor3 = theme.ButtonBg
    _onyx_uiColorsButton.TextColor3 = theme.ButtonText
    _onyx_uiColorsStroke.Color = theme.Border
    _onyx_currentThemeLabel.Text = "Current: " .. _onyx_currentThemeName
    _onyx_currentThemeLabel.TextColor3 = theme.MutedText
    _onyx_updateAntiAFKButton()
    _onyx_updateOpenButton()
    _onyx_openKeyButton.BackgroundColor3 = theme.ButtonBg
    _onyx_openKeyButton.TextColor3 = theme.ButtonText
    _onyx_openKeyStroke.Color = _onyx_waitingForOpenKey and theme.Accent or theme.Border
    _onyx_updateHalloweenDecorations(_onyx_currentThemeName)

    if _onyx_themePicker then
        local themeListObject = _onyx_themePicker:FindFirstChild("ThemeList")
        if themeListObject and themeListObject:IsA("ScrollingFrame") then
            themeListObject.BackgroundColor3 = theme.ScrollBg
            themeListObject.ScrollBarImageColor3 = theme.Accent
        end
    end

    for name, data in pairs(_onyx_themePickerButtons) do
        local selected = name == _onyx_currentThemeName
        data.button.Text = selected and "ON" or "OFF"
        data.button.BackgroundColor3 = selected and theme.AccentSoft or theme.ButtonBg
        data.button.TextColor3 = selected and theme.AccentBright or theme.ButtonText
        data.stroke.Color = selected and theme.Accent or theme.Border
        data.row.BackgroundColor3 = theme.PanelRowBg
        data.rowStroke.Color = theme.Border
    end

    if _onyx_themePicker then
        _onyx_themePicker.BackgroundColor3 = theme.MainBg
        local pickerStroke = _onyx_themePicker:FindFirstChild("PickerStroke")
        if pickerStroke and pickerStroke:IsA("UIStroke") then pickerStroke.Color = theme.Border end
        local pickerTitle = _onyx_themePicker:FindFirstChild("PickerTitle")
        if pickerTitle and pickerTitle:IsA("TextLabel") then pickerTitle.TextColor3 = theme.PrimaryText end
        local pickerHint = _onyx_themePicker:FindFirstChild("PickerHint")
        if pickerHint and pickerHint:IsA("TextLabel") then pickerHint.TextColor3 = theme.MutedText end
        local pickerClose = _onyx_themePicker:FindFirstChild("PickerClose")
        if pickerClose and pickerClose:IsA("TextButton") then pickerClose.TextColor3 = theme.SecondaryText end
    end
end

