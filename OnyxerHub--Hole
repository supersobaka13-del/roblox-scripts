function _onyx_stopAutoStrong()
    _onyx_autoStrongEnabled = false

    if _onyx_autoStrongConnection then
        _onyx_autoStrongConnection:Disconnect()
        _onyx_autoStrongConnection = nil
    end

    _onyx_restoreDumbbell()
    _onyx_updateAutoStrongButton()
end

function _onyx_startAutoStrong()
    if _onyx_autoStrongEnabled then
        return
    end

    _onyx_autoStrongEnabled = true
    _onyx_updateAutoStrongButton()

    _onyx_autoStrongAccumulator = 0
    _onyx_autoStrongConnection = _onyx_RunService.Heartbeat:Connect(function(dt)
        if not _onyx_autoStrongEnabled then
            return
        end

        _onyx_autoStrongAccumulator += dt
        if _onyx_autoStrongAccumulator < 0.12 then
            return
        end
        _onyx_autoStrongAccumulator = 0

        local humanoid = _onyx_getHumanoid()
        local tool = _onyx_findDumbbellTool()

        if not humanoid or humanoid.Health <= 0 or not tool then
            return
        end

        -- Keep the dumbbell usable, but remove its visible model from the hands.
        if tool.Parent ~= _onyx_player.Character then
            pcall(function()
                humanoid:EquipTool(tool)
            end)
        end

        _onyx_hideDumbbell(tool)

        if tool.Parent == _onyx_player.Character and tool.Enabled then
            pcall(function()
                tool:Activate()
            end)
        end
    end)
end

function _onyx_toggleAutoStrong()
    if _onyx_autoStrongEnabled then
        _onyx_stopAutoStrong()
    else
        _onyx_startAutoStrong()
    end
end

