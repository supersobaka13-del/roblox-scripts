function _onyx_findDumbbellTool()
    local character = _onyx_player.Character
    local backpack = _onyx_player:FindFirstChildOfClass("Backpack")

    local function isDumbbellTool(obj)
        if not obj or not obj:IsA("Tool") then
            return false
        end

        local name = string.lower(obj.Name)
        return name:find("dumbbell", 1, true)
            or name:find("гантел", 1, true)
            or name:find("weight", 1, true)
            or name:find("strength", 1, true)
    end

    if character then
        for _, child in ipairs(character:GetChildren()) do
            if isDumbbellTool(child) then
                return child
            end
        end
    end

    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if isDumbbellTool(child) then
                return child
            end
        end
    end

    return nil
end

function _onyx_hideDumbbell(tool)
    if not tool then
        return
    end

    for _, descendant in ipairs(tool:GetDescendants()) do
        if descendant:IsA("BasePart") then
            if _onyx_hiddenDumbbellParts[descendant] == nil then
                _onyx_hiddenDumbbellParts[descendant] = descendant.LocalTransparencyModifier
            end
            descendant.LocalTransparencyModifier = 1
        end
    end
end

function _onyx_restoreDumbbell()
    for part, transparency in pairs(_onyx_hiddenDumbbellParts) do
        if part and part.Parent and part:IsA("BasePart") then
            part.LocalTransparencyModifier = transparency
        end
    end
    table.clear(_onyx_hiddenDumbbellParts)
end

